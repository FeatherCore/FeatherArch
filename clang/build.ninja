# FeatherArch Clang Component Library Build System
# Uses Clang frontend + LLVM backend + Ninja build
#
# Build flow:
#   Source Code → Clang Frontend → LLVM IR → LLVM Optimizer →
#   LLVM Backend → Assembly → Object Code
#
# Usage (via PowerShell script):
#   .\build.ps1 -Target cm4 -CC clang -AR llvm-ar -CFLAGS "..."
#   .\build.ps1 -Target cm7 -CC clang -AR llvm-ar -CFLAGS "..."
#   .\build.ps1 -Target cm33 -CC clang -AR llvm-ar -CFLAGS "..."
#   .\build.ps1 -Target cm55 -CC clang -AR llvm-ar -CFLAGS "..."
#   .\build.ps1 -Target cm85 -CC clang -AR llvm-ar -CFLAGS "..."
#
# Or via environment variables:
#   $env:TARGET="cm4"; $env:CC="clang"; $env:AR="llvm-ar"; $env:CFLAGS="..."; ninja -f build.ninja cm4
#
# Required environment variables:
#   TARGET    - Target architecture: cm4, cm7, cm33, cm55, cm85
#   CC        - C compiler (e.g., clang, /path/to/clang)
#   AR        - Archiver (e.g., llvm-ar, /path/to/llvm-ar)
#   CFLAGS    - C compiler flags (e.g., --target=arm-none-eabi -mcpu=cortex-m4 ...)
#
# Optional environment variables:
#   INCLUDES  - Additional include paths
#   BUILD_DIR - Build output directory (default: build)

#==============================================================================
# Configuration (from environment variables)
#==============================================================================

# Target architecture
TARGET = $ENV{TARGET}

# Tools
CC = $ENV{CC}
AR = $ENV{AR}

# Compiler flags
CFLAGS = $ENV{CFLAGS}

# Additional includes
INCLUDES = $ENV{INCLUDES}

# Build directory
BUILD_DIR = $ENV{BUILD_DIR}

#==============================================================================
# Include Paths
#==============================================================================

ARMV7M_INCLUDES = -Iarm/cm/v7m -Iarm/cm/v7m/cm4 -Iarm/cm/v7m/cm7
ARMV8M_INCLUDES = -Iarm/cm/v8m -Iarm/cm/v8m/cm33 -Iarm/cm/v8m/cm55 -Iarm/cm/v8m/cm85

#==============================================================================
# Build Rules
#==============================================================================

# Rule: C source → Object (direct compilation)
rule cc_to_obj
  command = $CC $CFLAGS $includes $INCLUDES -c $in -o $out
  description = CC [$TARGET] $out
  depfile = $out.d
  deps = gcc

# Rule: Create static library
rule create_lib
  command = $AR rcs $out $in
  description = AR [$TARGET] $out

# Rule: Clean build artifacts
rule do_clean
  command = rm -rf build/
  description = CLEAN build artifacts

#==============================================================================
# Source File Rules - ARMv7-M Common
#==============================================================================

build $BUILD_DIR/arm_v7m_core.o: cc_to_obj arm/cm/v7m/arm_v7m_core.c
  includes = $ARMV7M_INCLUDES

build $BUILD_DIR/arm_v7m.o: cc_to_obj arm/cm/v7m/arm_v7m.c
  includes = $ARMV7M_INCLUDES

build $BUILD_DIR/arm_v7m_nvic.o: cc_to_obj arm/cm/v7m/arm_v7m_nvic.c
  includes = $ARMV7M_INCLUDES

build $BUILD_DIR/arm_v7m_systick.o: cc_to_obj arm/cm/v7m/arm_v7m_systick.c
  includes = $ARMV7M_INCLUDES

build $BUILD_DIR/arm_v7m_scb.o: cc_to_obj arm/cm/v7m/arm_v7m_scb.c
  includes = $ARMV7M_INCLUDES

build $BUILD_DIR/arm_v7m_mpu.o: cc_to_obj arm/cm/v7m/arm_v7m_mpu.c
  includes = $ARMV7M_INCLUDES

build $BUILD_DIR/arm_v7m_fpu.o: cc_to_obj arm/cm/v7m/arm_v7m_fpu.c
  includes = $ARMV7M_INCLUDES

build $BUILD_DIR/arm_v7m_debug.o: cc_to_obj arm/cm/v7m/arm_v7m_debug.c
  includes = $ARMV7M_INCLUDES

#==============================================================================
# Source File Rules - ARMv8-M Common
#==============================================================================

build $BUILD_DIR/arm_v8m_core.o: cc_to_obj arm/cm/v8m/arm_v8m_core.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m.o: cc_to_obj arm/cm/v8m/arm_v8m.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_nvic.o: cc_to_obj arm/cm/v8m/arm_v8m_nvic.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_systick.o: cc_to_obj arm/cm/v8m/arm_v8m_systick.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_scb.o: cc_to_obj arm/cm/v8m/arm_v8m_scb.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_mpu.o: cc_to_obj arm/cm/v8m/arm_v8m_mpu.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_sau.o: cc_to_obj arm/cm/v8m/arm_v8m_sau.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_cache.o: cc_to_obj arm/cm/v8m/arm_v8m_cache.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_fpu.o: cc_to_obj arm/cm/v8m/arm_v8m_fpu.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_mve.o: cc_to_obj arm/cm/v8m/arm_v8m_mve.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_pacbti.o: cc_to_obj arm/cm/v8m/arm_v8m_pacbti.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_pmu.o: cc_to_obj arm/cm/v8m/arm_v8m_pmu.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_ras.o: cc_to_obj arm/cm/v8m/arm_v8m_ras.c
  includes = $ARMV8M_INCLUDES

build $BUILD_DIR/arm_v8m_debug.o: cc_to_obj arm/cm/v8m/arm_v8m_debug.c
  includes = $ARMV8M_INCLUDES

#==============================================================================
# Source File Rules - Cortex-M4 Specific
#==============================================================================

build $BUILD_DIR/cm4/arm_v7m_cm4.o: cc_to_obj arm/cm/v7m/cm4/arm_v7m_cm4.c
  includes = $ARMV7M_INCLUDES

#==============================================================================
# Source File Rules - Cortex-M7 Specific
#==============================================================================

build $BUILD_DIR/cm7/arm_v7m_cm7.o: cc_to_obj arm/cm/v7m/cm7/arm_v7m_cm7.c
  includes = $ARMV7M_INCLUDES

#==============================================================================
# Source File Rules - Cortex-M33 Specific
#==============================================================================

build $BUILD_DIR/cm33/arm_v8m_cm33.o: cc_to_obj arm/cm/v8m/cm33/arm_v8m_cm33.c
  includes = $ARMV8M_INCLUDES

#==============================================================================
# Source File Rules - Cortex-M55 Specific
#==============================================================================

build $BUILD_DIR/cm55/arm_v8m_cm55.o: cc_to_obj arm/cm/v8m/cm55/arm_v8m_cm55.c
  includes = $ARMV8M_INCLUDES

#==============================================================================
# Source File Rules - Cortex-M85 Specific
#==============================================================================

build $BUILD_DIR/cm85/arm_v8m_cm85.o: cc_to_obj arm/cm/v8m/cm85/arm_v8m_cm85.c
  includes = $ARMV8M_INCLUDES

#==============================================================================
# Library Targets
#==============================================================================

# Cortex-M4 Library
build $BUILD_DIR/libfeatherarch_cm4.a: create_lib $
    $BUILD_DIR/arm_v7m_core.o $
    $BUILD_DIR/arm_v7m.o $
    $BUILD_DIR/arm_v7m_nvic.o $
    $BUILD_DIR/arm_v7m_systick.o $
    $BUILD_DIR/arm_v7m_scb.o $
    $BUILD_DIR/arm_v7m_mpu.o $
    $BUILD_DIR/arm_v7m_fpu.o $
    $BUILD_DIR/arm_v7m_debug.o $
    $BUILD_DIR/cm4/arm_v7m_cm4.o

# Cortex-M7 Library
build $BUILD_DIR/libfeatherarch_cm7.a: create_lib $
    $BUILD_DIR/arm_v7m_core.o $
    $BUILD_DIR/arm_v7m.o $
    $BUILD_DIR/arm_v7m_nvic.o $
    $BUILD_DIR/arm_v7m_systick.o $
    $BUILD_DIR/arm_v7m_scb.o $
    $BUILD_DIR/arm_v7m_mpu.o $
    $BUILD_DIR/arm_v7m_fpu.o $
    $BUILD_DIR/arm_v7m_debug.o $
    $BUILD_DIR/cm7/arm_v7m_cm7.o

# Cortex-M33 Library
build $BUILD_DIR/libfeatherarch_cm33.a: create_lib $
    $BUILD_DIR/arm_v8m_core.o $
    $BUILD_DIR/arm_v8m.o $
    $BUILD_DIR/arm_v8m_nvic.o $
    $BUILD_DIR/arm_v8m_systick.o $
    $BUILD_DIR/arm_v8m_scb.o $
    $BUILD_DIR/arm_v8m_mpu.o $
    $BUILD_DIR/arm_v8m_sau.o $
    $BUILD_DIR/arm_v8m_cache.o $
    $BUILD_DIR/arm_v8m_fpu.o $
    $BUILD_DIR/arm_v8m_mve.o $
    $BUILD_DIR/arm_v8m_pacbti.o $
    $BUILD_DIR/arm_v8m_pmu.o $
    $BUILD_DIR/arm_v8m_ras.o $
    $BUILD_DIR/arm_v8m_debug.o $
    $BUILD_DIR/cm33/arm_v8m_cm33.o

# Cortex-M55 Library
build $BUILD_DIR/libfeatherarch_cm55.a: create_lib $
    $BUILD_DIR/arm_v8m_core.o $
    $BUILD_DIR/arm_v8m.o $
    $BUILD_DIR/arm_v8m_nvic.o $
    $BUILD_DIR/arm_v8m_systick.o $
    $BUILD_DIR/arm_v8m_scb.o $
    $BUILD_DIR/arm_v8m_mpu.o $
    $BUILD_DIR/arm_v8m_sau.o $
    $BUILD_DIR/arm_v8m_cache.o $
    $BUILD_DIR/arm_v8m_fpu.o $
    $BUILD_DIR/arm_v8m_mve.o $
    $BUILD_DIR/arm_v8m_pacbti.o $
    $BUILD_DIR/arm_v8m_pmu.o $
    $BUILD_DIR/arm_v8m_ras.o $
    $BUILD_DIR/arm_v8m_debug.o $
    $BUILD_DIR/cm55/arm_v8m_cm55.o

# Cortex-M85 Library
build $BUILD_DIR/libfeatherarch_cm85.a: create_lib $
    $BUILD_DIR/arm_v8m_core.o $
    $BUILD_DIR/arm_v8m.o $
    $BUILD_DIR/arm_v8m_nvic.o $
    $BUILD_DIR/arm_v8m_systick.o $
    $BUILD_DIR/arm_v8m_scb.o $
    $BUILD_DIR/arm_v8m_mpu.o $
    $BUILD_DIR/arm_v8m_sau.o $
    $BUILD_DIR/arm_v8m_cache.o $
    $BUILD_DIR/arm_v8m_fpu.o $
    $BUILD_DIR/arm_v8m_mve.o $
    $BUILD_DIR/arm_v8m_pacbti.o $
    $BUILD_DIR/arm_v8m_pmu.o $
    $BUILD_DIR/arm_v8m_ras.o $
    $BUILD_DIR/arm_v8m_debug.o $
    $BUILD_DIR/cm85/arm_v8m_cm85.o

#==============================================================================
# Aliases for each target
#==============================================================================

build cm4: phony $BUILD_DIR/libfeatherarch_cm4.a
build cm7: phony $BUILD_DIR/libfeatherarch_cm7.a
build cm33: phony $BUILD_DIR/libfeatherarch_cm33.a
build cm55: phony $BUILD_DIR/libfeatherarch_cm55.a
build cm85: phony $BUILD_DIR/libfeatherarch_cm85.a

#==============================================================================
# Utility Targets
#==============================================================================

# Clean build artifacts
build clean: do_clean

# Show build info
build info: phony
  command = echo "FeatherArch Clang Build System"
  command = echo "=============================="
  command = echo "TARGET: $TARGET"
  command = echo "CC: $CC"
  command = echo "AR: $AR"
  command = echo "CFLAGS: $CFLAGS"
  command = echo "INCLUDES: $INCLUDES"
  command = echo "BUILD_DIR: $BUILD_DIR"

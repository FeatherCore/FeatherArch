# FeatherArch Clang Component Library Build System
# Uses Clang frontend + LLVM backend + Ninja build
#
# Build flow:
#   Source Code → Clang Frontend → LLVM IR → LLVM Optimizer →
#   LLVM Backend → Assembly → Object Code
#
# Usage:
#   ninja -f build.ninja                    # Build all (default: cm4)
#   ninja -f build.ninja clean              # Clean build artifacts
#   ninja -f build.ninja TARGET=cm7         # Build for Cortex-M7
#   ninja -f build.ninja TARGET=cm33        # Build for Cortex-M33
#   ninja -f build.ninja TARGET=cm55        # Build for Cortex-M55
#   ninja -f build.ninja TARGET=cm85        # Build for Cortex-M85

#==============================================================================
# Configuration
#==============================================================================

# Target selection (default: cm4)
TARGET = cm4

# Build type (debug/release)
BUILD_TYPE = release

# Directories
BUILD_DIR = build/$TARGET

#==============================================================================
# Toolchain Configuration
#==============================================================================

# Clang compiler driver
CC = clang

# LLVM tools
OPT = opt
LLC = llc
LLVM_DIS = llvm-dis
LLVM_AS = llvm-as

# Archiver
AR = llvm-ar

#==============================================================================
# Target-specific Flags
#==============================================================================

# Cortex-M4 (ARMv7-M + FPU)
CFLAGS_cm4 = --target=arm-none-eabi -mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard -DARMV7M -DCORTEX_M4

# Cortex-M7 (ARMv7-M + DP FPU)
CFLAGS_cm7 = --target=arm-none-eabi -mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=hard -DARMV7M -DCORTEX_M7

# Cortex-M33 (ARMv8-M Mainline + TrustZone + FPU)
CFLAGS_cm33 = --target=arm-none-eabi -mcpu=cortex-m33 -mthumb -mfpu=fpv5-sp-d16 -mfloat-abi=hard -DARMV8M -DCORTEX_M33 -mcmse

# Cortex-M55 (ARMv8.1-M Mainline + MVE + Helium)
CFLAGS_cm55 = --target=arm-none-eabi -mcpu=cortex-m55 -mthumb -mfpu=full -mfloat-abi=hard -DARMV8M -DCORTEX_M55 -mcmse

# Cortex-M85 (ARMv8.1-M Mainline + MVE + Helium + PACBTI)
CFLAGS_cm85 = --target=arm-none-eabi -mcpu=cortex-m85 -mthumb -mfpu=full -mfloat-abi=hard -DARMV8M -DCORTEX_M85 -mcmse

# Common flags
CFLAGS_common = -std=c11 -Wall -Wextra -Wpedantic -ffunction-sections -fdata-sections -fomit-frame-pointer -fno-strict-aliasing

# Release flags
CFLAGS_release = -O3 -DNDEBUG -ffast-math

# Debug flags
CFLAGS_debug = -O0 -g3 -DDEBUG

# Include paths
INCLUDES = -Iarm/cm/v7m -Iarm/cm/v8m

#==============================================================================
# Build Rules
#==============================================================================

# Rule: C source → LLVM IR (.ll)
rule cc_to_llvm
  command = $CC $target_flags $common_flags $build_type_flags $INCLUDES -S -emit-llvm $in -o $out
  description = CC [LLVM IR] $out

# Rule: LLVM IR → Optimized LLVM IR
rule opt_llvm
  command = $OPT -O3 -S $in -o $out
  description = OPT [LLVM] $out

# Rule: LLVM IR → Assembly
rule llvm_to_asm
  command = $LLC -mcpu=cortex-m4 -o $out $in
  description = LLC [ASM] $out

# Rule: C source → Object (direct)
rule cc_to_obj
  command = $CC $target_flags $common_flags $build_type_flags $INCLUDES -c $in -o $out
  description = CC [OBJ] $out
  depfile = $out.d
  deps = gcc

# Rule: Create static library
rule create_lib
  command = $AR rcs $out $in
  description = AR [LIB] $out

# Rule: Clean build artifacts
rule do_clean
  command = rm -rf build/
  description = CLEAN build artifacts

#==============================================================================
# Source Files - ARMv7-M Common
#==============================================================================

build $BUILD_DIR/armv7m_core.o: cc_to_obj arm/cm/v7m/armv7m_core.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/armv7m.o: cc_to_obj arm/cm/v7m/armv7m.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/armv7m_nvic.o: cc_to_obj arm/cm/v7m/armv7m_nvic.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/armv7m_systick.o: cc_to_obj arm/cm/v7m/armv7m_systick.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/armv7m_scb.o: cc_to_obj arm/cm/v7m/armv7m_scb.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/armv7m_mpu.o: cc_to_obj arm/cm/v7m/armv7m_mpu.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/armv7m_fpu.o: cc_to_obj arm/cm/v7m/armv7m_fpu.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/armv7m_debug.o: cc_to_obj arm/cm/v7m/armv7m_debug.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

#==============================================================================
# Source Files - Cortex-M4 Specific
#==============================================================================

build $BUILD_DIR/cm4/cm4.o: cc_to_obj arm/cm/v7m/cm4/cm4.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/cm4/cm4_core.o: cc_to_obj arm/cm/v7m/cm4/cm4_core.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/cm4/cm4_nvic.o: cc_to_obj arm/cm/v7m/cm4/cm4_nvic.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/cm4/cm4_systick.o: cc_to_obj arm/cm/v7m/cm4/cm4_systick.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/cm4/cm4_scb.o: cc_to_obj arm/cm/v7m/cm4/cm4_scb.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/cm4/cm4_mpu.o: cc_to_obj arm/cm/v7m/cm4/cm4_mpu.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/cm4/cm4_fpu.o: cc_to_obj arm/cm/v7m/cm4/cm4_fpu.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

build $BUILD_DIR/cm4/cm4_debug.o: cc_to_obj arm/cm/v7m/cm4/cm4_debug.c
  target_flags = $CFLAGS_cm4
  common_flags = $CFLAGS_common
  build_type_flags = $CFLAGS_release

#==============================================================================
# Library Targets
#==============================================================================

# Cortex-M4 Library
build $BUILD_DIR/libfeatherarch_cm4.a: create_lib $
    $BUILD_DIR/armv7m_core.o $
    $BUILD_DIR/armv7m.o $
    $BUILD_DIR/armv7m_nvic.o $
    $BUILD_DIR/armv7m_systick.o $
    $BUILD_DIR/armv7m_scb.o $
    $BUILD_DIR/armv7m_mpu.o $
    $BUILD_DIR/armv7m_fpu.o $
    $BUILD_DIR/armv7m_debug.o $
    $BUILD_DIR/cm4/cm4.o $
    $BUILD_DIR/cm4/cm4_core.o $
    $BUILD_DIR/cm4/cm4_nvic.o $
    $BUILD_DIR/cm4/cm4_systick.o $
    $BUILD_DIR/cm4/cm4_scb.o $
    $BUILD_DIR/cm4/cm4_mpu.o $
    $BUILD_DIR/cm4/cm4_fpu.o $
    $BUILD_DIR/cm4/cm4_debug.o

#==============================================================================
# Default Target
#==============================================================================

# Default: build library for selected target
build lib: phony $BUILD_DIR/libfeatherarch_cm4.a

# Default target
default lib

#==============================================================================
# Utility Targets
#==============================================================================

# Clean build artifacts
build clean: do_clean

# Show build info
build info: phony
  command = echo "FeatherArch Clang Build System"
  command = echo "=============================="
  command = echo "Target: $TARGET"
  command = echo "Build Type: $BUILD_TYPE"
  command = echo "Compiler: $CC"
  command = echo "Build Dir: $BUILD_DIR"
